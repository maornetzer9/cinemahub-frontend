# Copy this file to .env. Do not commit .env.
# Vite reads these when the dev server starts and when `npm run build` runs.
# Change them, then restart Vite or rebuild. They are embedded in the static bundle.

# cinema-ws base URL, with no trailing path.
# Local: http://localhost:3000
VITE_CINEMA_WB=http://localhost:3000

# subscriptions-ws base URL, with no trailing path.
# Local: http://localhost:3001
VITE_SUBSCRIPTIONS_WB=http://localhost:3001

# Render static site "Movies"
# Build command: npm install; npm run build
# Publish directory: ./dist
# Set both VITE_ variables in the Render environment before the build.
# Point them at the public backend origins, for example:
# VITE_CINEMA_WB=https://movies-user-backend.onrender.com
# VITE_SUBSCRIPTIONS_WB=https://movies-subscription-backend.onrender.com
# Those services currently host an older deployment. Replace the values when
# this release is deployed.
